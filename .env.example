# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side administrator passcode.
# If left unset, an administrator can claim the first-run Admin account directly in the UI.
ADMIN_PASSCODE=

# AUTH_TOKEN_SECRET: Optional stable HMAC secret for signing session tokens across restarts.
AUTH_TOKEN_SECRET=

# DATABASE_URL: Server-side PostgreSQL / Supabase connection string (never expose via VITE_*).
DATABASE_URL=

# Optional PostgreSQL SSL controls:
# - Set DATABASE_SSL=disable only for local non-TLS Postgres instances.
# - Set DATABASE_SSL_REJECT_UNAUTHORIZED=true when enforcing strict CA certificate verification.
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=

# Persistent File Storage (Supabase Storage REST API — server-only, never expose via VITE_*).
# When unset, uploads persist to local data/uploads/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="rxorbit-uploads"
